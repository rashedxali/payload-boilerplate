# Postgres connection string
DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Default admin user created by `bun run seed`
ADMIN_DEFAULT_USER_EMAIL=
ADMIN_DEFAULT_USER_PASSWORD=

# Resend email (https://resend.com) - optional
# Fallback for Settings > Integrations in the admin panel. Without an API key and a from
# address no email is sent; form submissions are still recorded in the CMS.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Invisible reCAPTCHA v2 - optional
# Fallback for Settings > Integrations in the admin panel. reCAPTCHA is disabled unless
# both the site key and the secret key are set.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
